# Maintainer: Your Name <you at example dot com>
#
# AUR package that builds the latest commit of LGallery (yay/paru rebuild it when the
# repository changes, with --devel).
pkgname=lgallery-git
_name=lgallery
pkgver=0.3.0.r0.g0000000
pkgrel=1
pkgdesc="One UI style photo and video gallery for KDE Plasma (latest git version)"
arch=('any')
url="https://github.com/lochansaroy02/lgallery"
license=('MIT')
depends=('python' 'pyside6' 'python-pillow' 'python-cryptography' 'qt6-declarative' 'qt6-svg' 'qt6-imageformats'
         'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'ffmpeg')
optdepends=('python-watchdog: live updates when files change'
            'python-send2trash: move to trash (a built-in freedesktop trash is used otherwise)'
            'python-pillow-heif: HEIC/HEIF photos'
            'python-opencv: People (on-device face grouping)'
            'purpose: KDE share menu (KDE Connect, Bluetooth, e-mail, Imgur, ...)'
            'plasma-integration: KDE global menu, native dialogs and theme'
            'dolphin: "Show in folder" selects the file'
            'xdg-utils: open files with other applications')
makedepends=('git')
provides=("$_name=${pkgver%%.r*}")
conflicts=("$_name")
source=("$_name::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    if git describe --long --tags --abbrev=7 >/dev/null 2>&1; then
        git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

package() {
    cd "$_name"
    install -dm755 "$pkgdir/usr/share/lgallery"
    cp -r main.py backend qml "$pkgdir/usr/share/lgallery/"
    find "$pkgdir/usr/share/lgallery" -name '__pycache__' -prune -exec rm -rf {} +
    python -m compileall -q -o 0 -o 1 -s "$pkgdir" -p / "$pkgdir/usr/share/lgallery"

    install -Dm644 packaging/icon.svg "$pkgdir/usr/share/lgallery/packaging/icon.svg"
    install -Dm644 packaging/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lgallery.svg"
    install -Dm644 packaging/lgallery.desktop "$pkgdir/usr/share/applications/lgallery.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /usr/bin/python3 /usr/share/lgallery/main.py "$@"\n' > "$pkgdir/usr/bin/lgallery"
    chmod 755 "$pkgdir/usr/bin/lgallery"
}
