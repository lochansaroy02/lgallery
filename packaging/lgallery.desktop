[Desktop Entry]
Type=Application
Name=Gallery
GenericName=Photo Gallery
Comment=Browse the pictures in your folders by date, One UI style
Exec=lgallery %F
TryExec=lgallery
Icon=lgallery
Terminal=false
Categories=Graphics;Viewer;Photography;Qt;KDE;
Keywords=photos;pictures;images;gallery;albums;
StartupWMClass=lgallery
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/heic;image/heif;
StartupNotify=true
